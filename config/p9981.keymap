#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/rgb.h>

#define DEFAULT 0
#define SYM     1
#define SYS     2
#define HW      3

#define SL_MO(layer) &sl_mo layer layer

&sl {
    release-after-ms = <3000>;
};

&mt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        // --- 1. Original Factory Behaviors (Preserved 100% in exact order to prevent ID shifting) ---
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mkp LCLK>, <&bt BT_CLR>;
        };

        td_boot_out: td_boot_out {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;            
            bindings = <&bootloader>, <&out OUT_TOG>;
        };

        tdc_to_SYM: td_comma_to_layer {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&kp SEMI>, <&to SYM>;
        };

        tdc_to_MEDIA: td_mute_to_layer {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&kp C_MUTE>, <&to SYS>;
        };

        td_kp_bleclear: td_kp_bleclear {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;            
            bindings = <&kp SPACE>, <&bt BT_CLR>;
        };

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <400>;
            bindings = <&kp>, <&kp>;
        };
    
        sl_mo: behavior_sl_mo {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <450>;
            bindings = <&mo>, <&sl>;
        };

        sk_kp: behavior_sk_kp {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <450>;
            bindings = <&kp>, <&sk>;
        };

        // --- 2. Custom Mod-Morphs appended at end (Tap unshifted, Shift consumed & inverted) ---
        under_morph: under_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp UNDER>, <&kp MINUS>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        plus_morph: plus_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp PLUS>, <&kp EQUAL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        colon_morph: colon_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COLON>, <&kp SEMI>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        caps_ht: caps_ht {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <0>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            bindings = <&m_caps_lock>, <&m_caps_word>;
        };
    };

    macros {
        m_caps_word: m_caps_word {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&caps_word>;
        };

        m_caps_lock: m_caps_lock {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp CAPSLOCK>;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_caps {
            timeout-ms = <50>;
            key-positions = <30 34>;
            bindings = <&caps_ht>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
// --------------------------------------------------------------------------------------------------------------------------
// |  Q   |  W   |  E   |  R   |  T   |  Y   |  U   |  I   |  O   |     P      |
// |  A   |  S   |  D   |  F   |  G   |  H   |  J   |  K   |  L   | Backspace  |
// | Cmd  |  Z   |  X   |  C   |  V   |  B   |  N   |  M   | TO 1 | RCtrl/Ent  |
// | LShift/Esc | SL/MO L1 | LAlt/Space | SL/MO L1 | RShift/Caps |
// --------------------------------------------------------------------------------------------------------------------------
    &kp Q        &kp W      &kp E       &kp R     &kp T         &kp Y             &kp U            &kp I            &kp O            &kp P
    &kp A        &kp S      &kp D       &kp F     &kp G         &kp H             &kp J            &kp K            &kp L            &kp BSPC
    &mt LGUI TAB &kp Z      &kp X       &kp C     &kp V         &kp B             &kp N            &kp M            &to SYM          &mt RCTRL ENTER
    &mt LSHFT ESC           &sl_mo SYM SYM        &mt LALT SPACE                  &sl_mo SYM SYM                    &mt RSHFT CLCK
            >;
        };

        sym_layer {
            bindings = <
// --------------------------------------------------------------------------------------------------------------------------
// |  #   |  1   |  2   |  3   |  [ { |  ] } |  ↑   | _ -  | + =  |     \ |    |
// |  ` ~ |  4   |  5   |  6   |  / ? |  ←   |  ↓   |  →   | ' "  | Backspace  |
// | Cmd  |  7   |  8   | 9 (  | 0 )  | , <  | . >  | : ;  | TO 0 | RCtrl/Ent  |
// | LShift/Esc |  TO 3   | LAlt/Space |   TO 2   | RShift/Caps |
// --------------------------------------------------------------------------------------------------------------------------
    &kp HASH     &kp N1     &kp N2      &kp N3    &kp LBKT      &kp RBKT          &kp UP           &under_morph     &plus_morph      &kp BSLH
    &kp GRAVE    &kp N4     &kp N5      &kp N6    &kp FSLH      &kp LEFT          &kp DOWN         &kp RIGHT        &kp APOS         &kp BSPC
    &mt LGUI TAB &kp N7     &kp N8      &kp N9    &kp N0        &kp COMMA         &kp DOT          &colon_morph     &to DEFAULT      &mt RCTRL ENTER
    &mt LSHFT ESC           &to HW                &mt LALT SPACE                  &to SYS                           &mt RSHFT CAPSLOCK
            >;
        };

        sys_layer {
            bindings = <
// --------------------------------------------------------------------------------------------------------------------------
// |  F1  |  F2  |  F3  |  F4  |  F5  |  F6  | Vol- | Vol+ | Mute | Play/Pause |
// |  F7  |  F8  |  F9  | F10  | F11  | F12  | PrtSc| Del  | Ins  | Backspace  |
// | Cmd  | Prev | Next | Bri- | Bri+ | PgUp | PgDn | Lock | TO 0 | RCtrl/Ent  |
// | LShift/Esc |  TO 1   | LAlt/Space |   TO 0   |   TO 0      |
// --------------------------------------------------------------------------------------------------------------------------
    &kp F1       &kp F2     &kp F3      &kp F4       &kp F5       &kp F6          &kp C_VOL_DN     &kp C_VOL_UP     &kp C_MUTE       &kp C_PP
    &kp F7       &kp F8     &kp F9      &kp F10      &kp F11      &kp F12         &kp PRINTSCREEN  &kp DEL          &kp INS          &kp BSPC
    &mt LGUI TAB &kp C_PREV &kp C_NEXT  &kp C_BRI_DN &kp C_BRI_UP &kp PG_UP       &kp PG_DN        &kp C_AL_LOCK    &to DEFAULT      &mt RCTRL ENTER
    &mt LSHFT ESC           &to SYM                  &mt LALT SPACE               &to DEFAULT                       &to DEFAULT
            >;
        };

        hw_layer {
            bindings = <
// --------------------------------------------------------------------------------------------------------------------------
// | BT 0 | BT 1 | BT 2 | BT 3 | BT 4 | BT 5 | RGB  | EFF  | BRI+ | BT CLR     |
// | BL Tg| BL - | BL + | RGB- | none | none | none | none | none | Backspace  |
// | Cmd  | Flash| USB  | BLE  | Pwr  | none | none | none | TO 0 | RCtrl/Ent  |
// | TO 0       |  TO 1   | LAlt/Space |   TO 0   |   TO 0      |
// --------------------------------------------------------------------------------------------------------------------------
    &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_SEL 5 &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_BRI  &bt BT_CLR
    &bl BL_TOG   &bl BL_DEC   &bl BL_INC   &rgb_ug RGB_BRD &none     &none        &none            &none            &none            &kp BSPC
    &mt LGUI TAB &td_boot_out &out OUT_USB &out OUT_BLE &ext_power EP_TOG &none   &none            &none            &to DEFAULT      &mt RCTRL ENTER
    &to DEFAULT               &to SYM                   &mt LALT SPACE                &to DEFAULT                       &to DEFAULT
            >;
        };
    };
};
